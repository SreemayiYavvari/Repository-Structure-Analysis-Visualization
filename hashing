"""
Hashing utilities used by the caching layer.
"""
import hashlib
from pathlib import Path


def sha256_of_file(filepath: str) -> str:
    """
    Compute the SHA256 hash of a file's contents.

    Raises:
        FileNotFoundError: if the path does not exist.
        IsADirectoryError: if the path is a directory, not a file.
    """
    path = Path(filepath).expanduser()

    if not path.exists():
        raise FileNotFoundError(f"File not found: {filepath}")
    if path.is_dir():
        raise IsADirectoryError(f"Path is a directory, not a file: {filepath}")

    sha256 = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            sha256.update(chunk)
    return sha256.hexdigest()


def sha256_of_text(text: str) -> str:
    """Compute the SHA256 hash of a text string. Used for testing/utilities."""
    return hashlib.sha256(text.encode("utf-8", errors="ignore")).hexdigest()
